
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the bottom of your screen
    //"height": 10, // Waybar height
    // "width": 1366, // Waybar width
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "hyprland/workspaces", "sway/mode", "custom/spotify"],
    //"modules-center": ["sway/window", "hyprland/window"],
    "modules-right": [
			"custom/notification",
			"pulseaudio",
			"network",
			//"cpu",
			//"memory",
			"battery",
			"tray",
			"clock"
		],
    "sway/workspaces": {
			"disable-scroll": true,
			"all-outputs": false,
			"format": "{icon}",
			"format-icons": {
					"11": "Scratch",
			},
    },
    "hyprland/workspaces": {
			"disable-scroll": true,
			"all-outputs": false,
			"format-icons": {
					"11": "Scratch",
			},
			"format": "{icon} {windows}",
			"window-rewrite-default": "",
			"workspace-taskbar": {
				//"enable": true,
				//"ignore-list": [ "Steam"],
			},
			"format-window-separator": " ",
			"window-rewrite": {
				"class<firefox>": "",
				"class<discord>": "",
				"class<steam>": "",
				"class<steam> title<Steam>": "",
				"class<kitty>": "󰄛",
				"title<*tmux.*>": "",
				"class<doublecmd>": "",
				"class<doublecmd> title<.*Double Commander.*": "",
				"class<REAPER>": "",
				"class<REAPER> title<.*REAPER v.*>": "󰋅",
				"class<zoom>": "󰰷",
				"class<>": "",
				"class<soffice>": "",
				"class<libreoffice-writer>": "",
				"class<libreoffice-math>": "",
				"class<libreoffice-draw>": "",
				"class<libreoffice-calc>": "",
				"class<libreoffice-base>": "",
				"class<libreoffice-impress>": "",
				"class<libreoffice-startcenter>": "",
				"class<obsidian>": "󰠮",
				"class<spotify>": "",
				"class<wofi>": "",
				"title<*MultiMC.*>": "󰍳",
				"class<blueman-manager>": "",
				"class<pavucontrol-qt>": "",
				"class<org.kde.filelight>": ""
			},
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
				"format": "{:%F | %I:%M %p }",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "",
            "on-scroll": 1,
            "on-click-right": "mode",
						"format": {
								"months":     "<span color='#cdd6f4'><b>{}</b></span>",
								//"days":       "<span color='#cdd6f4'><b>{}</b></span>",
								//"weeks":      "<span color='#89b4fa'><b>W{}</b></span>",
								"weekdays":   "<span color='#94e2d5'><b>{}</b></span>",
								"today":      "<span color='#a6e3a1'><b>{}</b></span>"
								},
						},
        },
    "cpu": {
        "format": "{usage}% "
    },
    "memory": {
        "format": "{}% "
    },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "none": " ",
      "dnd-notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "dnd-none": " ",
      "inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
      "inhibited-none": " ",
      "dnd-inhibited-notification": " <span foreground='#f38ba8'><sup></sup></span>",
      "dnd-inhibited-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
    "battery": {
        "bat": "BAT1",
        "states": {
            // "good": 95,
            "warning": 10,
            "critical": 5
        },
        "format": "{capacity}% {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠",
        "tooltip-format": "{signalStrength}%",
				"on-click": "pkill nm-applet || nm-applet"
    },
    "pulseaudio": {
        //"scroll-step": 1,
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} ",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
				//set theme because waybar is set to open with default theme, as it behaves better with css themeing
				"on-click": "pkill pavucontrol-qt || pavucontrol-qt"
    },
    "custom/spotify": {
        "format": " {}",
        "max-length": 40,
        "interval": 30, // Remove this if your script is endless and write in loop
        "exec": "$HOME/.config/waybar/mediaplayer.sh 2> /dev/null", // Script in resources folder
        "exec-if": "pgrep spotify"
    }
}
